<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFrameworks Condition="$([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::Windows)))">net48;net6.0</TargetFrameworks>
    <TargetFrameworks Condition="!$([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::Windows)))">net6.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ModuleName>$(AssemblyName)</ModuleName>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net48'">
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="PowerShellStandard.Library" Version="5.1.1" PrivateAssets="All" />
    <EmbeddedResource Include="../../lib/borders.json" Link="Resources/borders.json" />
    <EmbeddedResource Include="../../lib/spinners.json" Link="Resources/spinners.json" />
  </ItemGroup>

  <Target Name="PostBuild" AfterTargets="PostBuildEvent">
    <ItemGroup>
      <FilesToCopy Include="$(TargetDir)**\*.dll" />
    </ItemGroup>
    
    <Copy 
      SourceFiles="@(FilesToCopy)" 
      DestinationFolder="$(ProjectDir)../../lib/$(TargetFramework)/%(RecursiveDir)" 
      SkipUnchangedFiles="true" />
      
    <Message Text="Module files successfully copied to dist folder." Importance="high" />
  </Target>

</Project>
